# Copy to .env and fill in the values marked REQUIRED.
#
# API_BASE_URL / API_KEY are deliberately NOT set here: config.json already holds
# them, and an env value silently overrides config.json. Only uncomment these if
# you want to point the bot somewhere else. An unused placeholder value like
# https://api.example.com/api overrides a perfectly good config.json and every
# API call then fails to resolve.

BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
ADMIN_IDS=123456789,987654321

# API_BASE_URL=https://api.qasimdev.dpdns.org/api
# API_KEY=your-api-key

# Where the BoltDB file lives. The parent directory is created at startup if it
# can be, and if it cannot the bot falls back to ./data/bot.db with a warning.
#
# A relative path is right for `go run main.go`. Only use an absolute system path
# when you know it is writable: /bot/data below is the Docker layout, and outside
# Docker creating /bot needs root, so on a normal host it fails and falls back.
DB_PATH=./data/bot.db
# DB_PATH=/bot/data/bot.db

# Kraken, the AI agent. Both values are already in config.json, and an env value
# silently overrides config.json — so leave these commented unless you want to
# point the agent somewhere else. An unfilled placeholder here is worse than
# nothing: it wins over the working key in config.json and every request then
# fails to authenticate, leaving the agent silent.
# AI_BASE_URL=https://example.invalid
# AI_KEY=

# Runtime tuning for small instances.
MEM_LIMIT_MB=400
GC_PERCENT=50
